/.next/
/out/
next-env.d.ts
*.tsbuildinfo

# Production builds
/build
dist/
dist

# Secrets & credentials (never commit real values)
# Keep templates via !.env.example below

*token.json*
credentials.json
**/credentials.json
*credentials.json*
*secrets.json*
*secret.json*
service_role*
*service_role*
*SERVICE_ROLE*
*.pem
*.key
*.p12
*.pfx
*.crt
id_rsa
id_rsa.*
*.keystore
cookie*.txt
*-cookies.txt
javion-cookies.txt
.credentials

# Real env files (all locations)
.env
.env.*
*.env
**/.env
**/.env.*
**/.env.local
**/.env.*.local
.env.local
.env.development.local
.env.test.local
.env.production.local

# Allow safe templates (no real passwords/secrets)
!.env.example
!**/.env.example
!**/.env*.example
!*.env.example

# Logs and debug files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dump.rdb

